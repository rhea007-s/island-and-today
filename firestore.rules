rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user owns exactly users/{their uid} and everything below
    // it (tasks, focus sessions). Nobody can list users or read anyone else.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
